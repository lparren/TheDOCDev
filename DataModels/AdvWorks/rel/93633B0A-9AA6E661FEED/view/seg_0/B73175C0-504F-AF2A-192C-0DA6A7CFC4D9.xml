<userDefinedSQL><![CDATA[CREATE OR REPLACE VIEW VASSOCSEQORDERS
AS 
SELECT DISTINCT ordernumber,
                   customerkey,
                   region,
                   incomegroup
     FROM vdmprep
    WHERE fiscalyear = 2013]]></userDefinedSQL>
