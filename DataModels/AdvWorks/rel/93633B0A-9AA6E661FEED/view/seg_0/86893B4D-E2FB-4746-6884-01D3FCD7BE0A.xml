<userDefinedSQL><![CDATA[CREATE OR REPLACE VIEW VASSOCSEQLINEITEMS
AS 
SELECT ordernumber,
          linenumber,
          model
     FROM vdmprep
    WHERE fiscalyear = 2013]]></userDefinedSQL>
